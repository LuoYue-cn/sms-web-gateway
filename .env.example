# Copy to .env and adjust. docker compose reads this file automatically.

# Host port for the web UI / API (container port 80).
HTTP_PORT=8080

# Public base URL used as the default in the device pairing QR code, e.g. https://sms.example.com
# Leave empty to use the host the browser is connected to.
PUBLIC_URL=

# Container timezone (data is always stored in UTC).
TZ=UTC
